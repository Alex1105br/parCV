# ==============================
# Banco de dados (PostgreSQL)
# ==============================
# String de conexão com o PostgreSQL. O projeto fala diretamente com o
# Postgres via psycopg2/SQLAlchemy — não usa a API/SDK do Supabase, então
# nenhuma outra variável de "Supabase" é necessária aqui.
#
# Se o banco estiver no Supabase: painel → Connect → Direct connection →
# Session pooler → URI (troque [YOUR-PASSWORD] pela senha do projeto).
#
# Se for um Postgres local, use algo como:
# postgresql://parcv:parcv@localhost:5432/parcv
DATABASE_URL=

# ==============================
# LLM
# ==============================
# Backend de IA: groq (nuvem) ou ollama (local)
LLM_BACKEND=groq

# Chave da API Groq — https://console.groq.com/keys
# Obrigatória quando LLM_BACKEND=groq (a aplicação não inicia sem ela)
GROQ_API_KEY=

# Modelo usado na Groq (opcional — padrão: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Configuração alternativa, só se LLM_BACKEND=ollama ---
# Endereço do servidor Ollama local (padrão: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Modelo usado no Ollama (padrão: qwen2.5:7b)
# MODEL=qwen2.5:7b

# ==============================
# App
# ==============================
# Chave secreta do Flask para assinar cookies de sessão
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Pasta temporária para arquivos enviados (opcional — padrão: /tmp/uploads)
# UPLOAD_FOLDER=/tmp/uploads

# ==============================
# E-mail (recuperação de senha)
# ==============================
# Envio via SMTP tradicional (Mailtrap para testes, Gmail para produção)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true

# Usuário/senha do Mailtrap (Email Testing → Inbox → SMTP Settings)
# ou, para Gmail, seu e-mail + App Password (myaccount.google.com/apppasswords)
MAIL_USERNAME=
MAIL_PASSWORD=

# Remetente exibido nos e-mails via SMTP — para Gmail, use o mesmo
# e-mail do MAIL_USERNAME (o Gmail exige isso)
MAIL_DEFAULT_SENDER=parCV <seu@gmail.com>
