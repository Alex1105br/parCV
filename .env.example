# ==============================
# Supabase
# ==============================

# URL do projeto — Settings → API → Project URL
SUPABASE_URL=https://xxxx.supabase.co

# Chave anônima — Settings → API Keys → anon public
SUPABASE_KEY=eyJhbGci...

# String de conexão — Connect → Direct → Session pooler → URI
# Troque [YOUR-PASSWORD] pela senha definida ao criar o projeto
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# ==============================
# LLM
# ==============================

# Backend de IA: groq (nuvem) ou ollama (local)
LLM_BACKEND=groq

# Chave da API Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ==============================
# App
# ==============================

# Chave secreta do Flask para assinar cookies de sessão
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=