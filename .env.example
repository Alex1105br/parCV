# ==============================
# Supabase
# ==============================
# URL do projeto — Settings → API → Project URL
SUPABASE_URL=

# Chave anônima — Settings → API Keys → anon public
SUPABASE_KEY=

# String de conexão — Connect → Direct → Session pooler → URI
# Troque [YOUR-PASSWORD] pela senha definida ao criar o projeto
DATABASE_URL=

# ==============================
# LLM
# ==============================
# Backend de IA: groq (nuvem) ou ollama (local)
LLM_BACKEND=groq

# Chave da API Groq — https://console.groq.com/keys
GROQ_API_KEY=

# ==============================
# App
# ==============================
# Chave secreta do Flask para assinar cookies de sessão
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ==============================
# E-mail (recuperação de senha)
# ==============================
# Duas formas de envio — configure UMA delas. Se RESEND_API_KEY estiver
# preenchida, ela tem prioridade e os campos MAIL_* abaixo são ignorados.

# --- Opção A: Resend (API via HTTPS — recomendado se a rede bloquear SMTP) ---
# Conta gratuita em https://resend.com → API Keys → Create API Key
RESEND_API_KEY=

# Sem domínio verificado em resend.com/domains, o remetente só pode usar
# o domínio de teste onboarding@resend.dev (e só envia para o e-mail
# cadastrado na sua conta Resend)
RESEND_SENDER=parCV <onboarding@resend.dev>

# --- Opção B: SMTP tradicional (Mailtrap para testes, Gmail para produção) ---
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# Usuário/senha do Mailtrap (Email Testing → Inbox → SMTP Settings)
# ou, para Gmail, seu e-mail + App Password (myaccount.google.com/apppasswords)
MAIL_USERNAME=
MAIL_PASSWORD=

# Remetente exibido nos e-mails via SMTP — para Gmail, use o mesmo
# e-mail do MAIL_USERNAME (o Gmail exige isso)
MAIL_DEFAULT_SENDER=parCV <seu@gmail.com>
